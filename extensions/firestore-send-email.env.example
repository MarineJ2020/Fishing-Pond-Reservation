# Copy to firestore-send-email.env only for local Firebase CLI use (git-ignored).
# Mail server: Exabytes (mail.kolamkelisayang.com.my:465).
# Keep the password OUT of SMTP_CONNECTION_URI: the extension re-encodes a URI
# password, so %40/%25 become %2540/%2525 and login fails with "535".
# The password lives in Secret Manager as SMTP_PASSWORD. To change it, run
#   npx.cmd -y firebase-tools ext:configure firestore-send-email --project kolamkelisayang
# choose "Set new value" at SMTP password (type it plain), then
#   npx.cmd -y firebase-tools deploy --only extensions --project kolamkelisayang
AUTH_TYPE=UsernamePassword
DATABASE=(default)
DATABASE_REGION=asia-southeast1
DEFAULT_FROM=hello@kolamkelisayang.com.my
DEFAULT_REPLY_TO=hello@kolamkelisayang.com.my
firebaseextensions.v1beta.function/location=us-central1
MAIL_COLLECTION=mail
OAUTH_PORT=465
OAUTH_SECURE=false
SMTP_CONNECTION_URI=smtps://hello%40kolamkelisayang.com.my@mail.kolamkelisayang.com.my:465
SMTP_PASSWORD=projects/735046287294/secrets/ext-firestore-send-email-SMTP_PASSWORD/versions/1
TTL_EXPIRE_TYPE=never
TTL_EXPIRE_VALUE=1
