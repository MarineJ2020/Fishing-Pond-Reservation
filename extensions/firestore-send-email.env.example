# Copy this file to firestore-send-email.env only for local Firebase CLI use.
# Never commit the real file: SMTP_CONNECTION_URI contains a Zoho app password.
AUTH_TYPE=UsernamePassword
DATABASE=(default)
DATABASE_REGION=asia-southeast1
DEFAULT_FROM=hello@kolamkelisayang.com.my
DEFAULT_REPLY_TO=hello@kolamkelisayang.com.my
firebaseextensions.v1beta.function/location=asia-southeast1
MAIL_COLLECTION=mail
OAUTH_PORT=465
OAUTH_SECURE=false
SMTP_CONNECTION_URI=smtps://SMTP_USERNAME:ZOHO_APP_PASSWORD@smtp.zoho.com:465
TTL_EXPIRE_TYPE=day
TTL_EXPIRE_VALUE=3
