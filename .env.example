# Cloudinary Configuration (for receipt uploads - 25GB free)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
VITE_USE_FIREBASE_EMULATOR=false

# Functions Base URL (for Cloud Functions or App Hosting)
# Leave blank if you want the app to use Firestore fallback for bookings while functions are unavailable.
VITE_FUNCTIONS_BASE_URL=http://localhost:5001/your_project/us-central1

# Firebase Admin SDK (for Cloud Functions)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n

# Firebase App Check — reCAPTCHA v3 site key (public). Used to gate Firestore
# writes (incl. the `mail` collection routed to Zoho SMTP via the Trigger Email
# extension) against scripted abuse. Register the site in Firebase Console →
# App Check, paste the site key here. Leave blank for local dev with emulator.
VITE_RECAPTCHA_SITE_KEY=

# Transactional email is routed through Zoho Mail Lite SMTP via the
# "Trigger Email from Firestore" Firebase extension. The SMTP credentials are
# configured in the extension itself (stored in Cloud Secret Manager), not here.
# Required values when installing/reconfiguring the extension:
#   SMTP connection URI: smtps://noreply%40kolamkelisayang.com.my:APP_PASSWORD@smtp.zoho.com:465
#   Default FROM:        Kolam Keli Sayang <noreply@kolamkelisayang.com.my>
#   Default REPLY-TO:    hello@kolamkelisayang.com.my
#   Mail collection:     mail
#   TTL:                 3 days
