rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Rules PDF published from CMS landing-content.
    match /fishing-pond-rules/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.role in ['ADMIN', 'STAFF'] ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['ADMIN', 'STAFF', 'Admin', 'Staff', 'admin', 'staff']
      );
    }

    // Booking receipts uploaded by signed-in users/staff.
    match /fishing-pond-receipts/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Pond/media images handled elsewhere; keep default deny for safety.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
