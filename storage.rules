rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function roleFromDoc() {
      return request.auth != null
        ? firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
        : '';
    }

    function isAdmin() {
      return request.auth != null && roleFromDoc() == 'ADMIN';
    }

    function isStaff() {
      return request.auth != null && roleFromDoc() in ['STAFF', 'ADMIN'];
    }

    // Rules PDF published from CMS landing-content.
    match /fishing-pond-rules/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Booking receipts uploaded by signed-in users/staff.
    match /fishing-pond-receipts/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Pond layout/arrangement map shown on the public booking page (admin-managed).
    match /fishing-pond-maps/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bank transfer QR code shown on the public booking page (admin-managed).
    match /fishing-pond-payment-qr/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Scale/weight photos shown on the public live-results page (staff-captured).
    match /fishing-pond-weights/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Homepage hero/section background images + logos uploaded from CMS > Laman Utama.
    match /fishing-pond-landing/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Open Graph / Twitter share images uploaded from CMS > SEO.
    match /fishing-pond-seo/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Anything else stays denied for safety.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
