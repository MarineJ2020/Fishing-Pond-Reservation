rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function roleFromDoc() {
      return request.auth != null
        ? firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
        : '';
    }

    function isAdmin() {
      return request.auth != null && roleFromDoc() == 'ADMIN';
    }

    function isStaff() {
      return request.auth != null && roleFromDoc() in ['STAFF', 'ADMIN'];
    }

    // Rules PDF published from CMS landing-content.
    match /fishing-pond-rules/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Temporary compatibility for historical, single-folder receipt URLs.
    match /fishing-pond-receipts/{fileName} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // New files are immutable: replacing a receipt uploads a fresh object.
    match /fishing-pond-receipts/{uid}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == uid || isStaff());
      allow create: if request.auth != null && request.auth.uid == uid
        && resource == null
        && request.resource.size > 0 && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
      allow update, delete: if false;
    }

    // Pond layout/arrangement map shown on the public booking page (admin-managed).
    match /fishing-pond-maps/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bank transfer QR code shown on the public booking page (admin-managed).
    match /fishing-pond-payment-qr/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Scale/weight photos shown on the public live-results page (staff-captured).
    match /fishing-pond-weights/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Homepage hero/section background images + logos uploaded from CMS > Laman Utama.
    match /fishing-pond-landing/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Open Graph / Twitter share images uploaded from CMS > SEO.
    match /fishing-pond-seo/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Anything else stays denied for safety.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
