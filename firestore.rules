rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function userDocPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function roleFromToken() {
      return isSignedIn() && request.auth.token.role is string ? request.auth.token.role : '';
    }

    function roleFromDoc() {
      return isSignedIn() && exists(userDocPath(request.auth.uid))
        ? get(userDocPath(request.auth.uid)).data.role
        : '';
    }

    // Admin/Staff are treated as the same role in this system.
    function isAdmin() {
      return isSignedIn() && (
        roleFromToken() in ['STAFF', 'ADMIN'] ||
        roleFromDoc() in ['STAFF', 'ADMIN']
      );
    }

    // Public browsing collections.
    match /competitions/{competitionId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /ponds/{pondId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /seats/{seatId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /settings/{settingsId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // User profiles: readable by owner or admin; only admin can change roles.
    match /users/{uid} {
      allow read: if request.auth.uid == uid || isAdmin();

      allow create: if request.auth.uid == uid
        && request.resource.data.email is string
        && request.resource.data.name is string
        && request.resource.data.role == 'CLIENT';

      allow update: if (request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email)
        || isAdmin();

      allow delete: if isAdmin();
    }

    // Bookings: publicly readable (client policy). Any signed-in user can create.
    // Admin manually approves every booking, so no field-level validation here.
    match /bookings/{bookingId} {
      // The booking owner is matched by email — bookings store userId/userEmail as
      // the signing email on the no-Functions direct-write path.
      function ownsBooking() {
        return isSignedIn() && request.auth.token.email != null && (
          request.auth.token.email == resource.data.userId ||
          request.auth.token.email == resource.data.userEmail
        );
      }

      // Owners may append payment receipts (deposit balance flow) when there is no
      // Cloud Functions backend. Constrained to receipt fields only so a client can
      // never self-approve (status/paidAmount/totals stay admin-only). Rejected
      // bookings are frozen.
      function ownerReceiptUpdate() {
        return ownsBooking()
          && resource.data.status != 'REJECTED'
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['receipts', 'receiptUrl', 'receiptReuploadUsed', 'updatedAt', 'updatedBy']);
      }

      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isAdmin() || ownerReceiptUpdate();
      allow delete: if isAdmin();

      match /payments/{paymentId} {
        allow read: if isAdmin() || request.auth.uid == get(/databases/$(database)/documents/bookings/$(bookingId)).data.userId;
        allow create, update, delete: if isAdmin();
      }
    }

    match /seatLocks/{lockId} {
      allow read: if isAdmin() || request.auth.uid == resource.data.userId;
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time;
      allow delete: if isAdmin() || request.auth.uid == resource.data.userId;
      allow update: if false;
    }

    match /eventResults/{resultId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Outbound email queue consumed by the "Trigger Email from Firestore" extension
    // (routed to Zoho Mail Lite SMTP). Writes are constrained so authenticated users
    // cannot mail third parties using our sender reputation:
    //   - Staff can queue mail to anyone (needed for the approval flow).
    //   - Regular users can only queue mail to themselves, CC'd to the staff inbox.
    // Reads/updates/deletes are denied so queued docs are write-only from the client;
    // the extension deletes them via TTL after sending.
    match /mail/{docId} {
      allow create: if isSignedIn()
        && request.resource.data.message.subject is string
        && request.resource.data.message.html is string
        && request.resource.data.message.html.size() < 100000
        && (
          isAdmin()
          ||
          (request.auth.token.email == request.resource.data.to
            && request.resource.data.cc is list
            && request.resource.data.cc.size() == 1
            && request.resource.data.cc[0] == 'hello@kolamkelisayang.com.my')
        );
      allow read, update, delete: if false;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
