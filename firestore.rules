rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function userDocPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function roleFromDoc() {
      return isSignedIn() && exists(userDocPath(request.auth.uid))
        ? get(userDocPath(request.auth.uid)).data.role
        : '';
    }

    function isStaff() {
      return isSignedIn() && roleFromDoc() in ['STAFF', 'ADMIN'];
    }

    function isAdmin() {
      return isSignedIn() && roleFromDoc() == 'ADMIN';
    }

    // Public browsing collections.
    match /competitions/{competitionId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /ponds/{pondId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /seats/{seatId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /settings/{settingsId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Staff may browse accounts for competition-day operations. Client-side
    // writes may never change roles; the updateUserRole callable owns that path.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isStaff());

      allow create: if request.auth.uid == uid
        && request.resource.data.email is string
        && request.resource.data.name is string
        && request.resource.data.role == 'CLIENT';

      allow update: if (isSignedIn() && request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email)
        || (isAdmin()
          && request.resource.data.role == resource.data.role);

      // Account deletion is reserved for trusted Admin SDK tooling so an admin
      // cannot bypass the immutable-admin rule by deleting another profile.
      allow delete: if false;
    }

    function ownsBookingData(data) {
      return isSignedIn() && (
        data.get('userId', '') == request.auth.uid
        || data.get('userId', '') == userDocPath(request.auth.uid)
        || (request.auth.token.get('email_verified', false) == true
          && request.auth.token.get('email', '') != ''
          && request.auth.token.email in [data.get('userId', ''), data.get('userEmail', '')])
      );
    }

    // Creation and customer receipt transitions run through trusted Functions.
    match /bookings/{bookingId} {

      function staffCheckInUpdate() {
        return isStaff()
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'checkedInSeatKeys', 'checkedInSeats', 'checkedIn', 'checkedInAt',
            'checkedInSeatTimes', 'updatedAt', 'updatedBy'
          ]);
      }

      allow read: if isStaff() || ownsBookingData(resource.data);
      allow create: if false;
      allow update: if isAdmin() || staffCheckInUpdate();
      allow delete: if isAdmin();

      match /payments/{paymentId} {
        allow read: if isStaff() || ownsBookingData(get(/databases/$(database)/documents/bookings/$(bookingId)).data);
        allow create: if isAdmin() || (isStaff()
          && request.resource.data.keys().hasOnly(['amount', 'method', 'recordedBy', 'createdAt'])
          && request.resource.data.amount is number
          && request.resource.data.method is string
          && request.resource.data.recordedBy == request.auth.uid
          && request.resource.data.createdAt is timestamp);
        allow update, delete: if isAdmin();
      }
    }

    match /seatLocks/{lockId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time;
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow update: if false;
    }

    match /eventResults/{resultId} {
      allow read: if true;
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly([
          'competitionId', 'bookingId', 'anglerName', 'pondId', 'pondName',
          'seatNum', 'weight', 'photoUrl', 'ocrConfidence', 'ocrRawText',
          'ocrUserVerified', 'scanMethod', 'capturedBy', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.capturedBy == request.auth.uid;
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'anglerName', 'pondId', 'pondName', 'seatNum', 'weight', 'photoUrl',
          'ocrConfidence', 'ocrRawText', 'ocrUserVerified', 'scanMethod', 'updatedAt'
        ]);
      allow delete: if isStaff();
    }

    // Admin activity log — append-only. Nothing may edit or delete an entry
    // once written, so the trail stays tamper-evident.
    match /auditLog/{entryId} {
      allow read: if isAdmin();
      allow create: if isStaff()
        && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Outbound email queue consumed by the Trigger Email extension. Only trusted
    // Cloud Functions/Admin SDK code may create or mutate jobs; clients call
    // narrow callable functions and can never supply recipients or raw HTML.
    match /mail/{docId} {
      allow read, write: if false;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
