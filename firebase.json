{
  "firestore": {
    "database": "(default)",
    "location": "asia-southeast1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "lib",
        "**/*.bak"
      ]
    }
  ],
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/fonts/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/",
        "function": {
          "functionId": "seoRender",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/book",
        "function": {
          "functionId": "seoRender",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/live",
        "function": {
          "functionId": "seoRender",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/confirmed",
        "function": {
          "functionId": "seoRender",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/sitemap.xml",
        "function": {
          "functionId": "seoRender",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/landing-img",
        "function": {
          "functionId": "landingImage",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/api/**",
        "function": {
          "functionId": "api",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "**",
        "destination": "/app.html"
      }
    ]
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "KKS",
        "supportEmail": "hello@kolamkelisayang.com.my"
      }
    }
  },
  "extensions": {
    "firestore-send-email": "firebase/firestore-send-email@0.2.9"
  }
}
